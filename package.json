{
  "name": "st-moritz-proposal-microsite",
  "version": "1.0.0",
  "private": true,
  "description": "Proposal builder with backend persistence, PDF export flow, and admin version dashboard.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:operator": "node marketing-agents/operator-app.js",
    "migrate:sharepoint-content": "node scripts/migrate-content-library.js --source content-library.json --manifest content-library.manifest.json --contentDir migrated-content",
    "pw:jwblng:audit": "playwright test -c jwblng-mvp/playwright/playwright.config.js jwblng-mvp/playwright/tests/audit.kajabi.spec.js",
    "pw:jwblng:join": "playwright test -c jwblng-mvp/playwright/playwright.config.js jwblng-mvp/playwright/tests/create-join-flow.spec.js",
    "pw:jwblng:verify": "playwright test -c jwblng-mvp/playwright/playwright.config.js jwblng-mvp/playwright/tests/verify-member-journey.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "dotenv": "^16.4.5"
  }
}
