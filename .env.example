PORT=3000
PUBLIC_DIR=.
PROPOSAL_DATA_DIR=./data
LIBRARY_FILE=./content-library.json
CONTENT_PROVIDER=json
# For a future SharePoint-backed provider, configure a provider manifest path:
# CONTENT_PROVIDER=sharepoint
# CONTENT_PROVIDER_SETTINGS={"manifestFile":"./content-library.manifest.json","siteId":"...","driveId":"...","manifestPath":"path/to/content-manifest.json","basePath":"content","graphBaseUrl":"https://graph.microsoft.com/v1.0"}
# Optional auth helper for Graph endpoints:
# GRAPH_ACCESS_TOKEN=<optional bearer token>
BRAND_NAME=St. Moritz Security Services
BRAND_TAGLINE=Proposal Builder
CLIENT_NAME_FALLBACK=St. Moritz Client
CORS_ORIGINS=*
WORD_IMAGES_ENABLED=1
# Operator Console
# OPS_APP_PORT=3201
# AIRCALL_WEBHOOK_TOKEN=<set-a-random-long-token>
# AIRCALL_WEBHOOK_SECRET=<optional-hmac-secret>
