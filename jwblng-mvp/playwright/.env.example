# Copy this file to .env (project root) and fill values.

# Base Kajabi site URL (no trailing slash)
KAJABI_BASE_URL=https://YOUR-SITE.mykajabi.com

# Preferred for app.kajabi.com site-scoped admin URLs.
# Example: https://app.kajabi.com/admin/sites/2148584608
KAJABI_ADMIN_BASE_URL=

# Optional: custom domain if you want journey verification there
JWBLNG_PUBLIC_URL=https://jwblng.org

# Storage state path saved by Playwright after manual login
KAJABI_STORAGE_STATE=jwblng-mvp/playwright/.auth/kajabi-admin.json

# Safety gate. Keep 0 by default to prevent write actions.
ALLOW_KAJABI_WRITES=0

# Optional values used by write-flow script
JWBLNG_JOIN_PAGE_TITLE=Join JWBLNG
JWBLNG_JOIN_PAGE_PATH=/join
JWBLNG_JOIN_PAGE_CTA=Apply Now
JWBLNG_EVENT_TITLE=JWBLNG Event Draft
JWBLNG_EVENT_DATE=
JWBLNG_EVENT_TIME=
JWBLNG_EVENT_TIMEZONE=
JWBLNG_EVENT_DESCRIPTION=
JWBLNG_CONTACT_EMAIL_FILTER=
JWBLNG_APPROVAL_TAG=approved-member
